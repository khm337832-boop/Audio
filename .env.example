# ---------------------------------------------------------------- web service (Render)
# Render က PORT ကို အလိုလို ပေးတယ် — `python main.py serve` က ဒါကို bind လုပ်တယ်
PORT=8080

# ---------------------------------------------------------------- Telegram
BOT_TOKEN=

# ---------------------------------------------------------------- LLM (Gemini)
# ဇာတ်လမ်း ၂၀,၀၀၀–၂၅,၀၀၀ စာလုံး၊ SEO ခေါင်းစဉ်/ဖော်ပြချက်၊ ဇာတ်ကွက် prompt — အားလုံး ဒီ key ကို သုံးတယ်
GEMINI_API_KEY=
# Google က model အဟောင်း ပိတ်လိုက်ရင် (404) အောက်က fallback တွေကို အလိုလို စမ်းတယ်
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-flash-latest,gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-3.8-flash-image
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-flash-latest

# ---------------------------------------------------------------- ဇာတ်လမ်း အရှည်
STORY_MIN_CHARS=20000
STORY_MAX_CHARS=25000
STORY_CHAPTER_CHARS=1200
STORY_MAX_CHAPTERS=30
STORY_LANGUAGE=my

# ---------------------------------------------------------------- အသံ (voice over)
# auto | edge | gtts | local | elevenlabs
#   auto → မြန်မာ: local → edge → gtts → elevenlabs | အင်္ဂလိပ်: elevenlabs → edge → gtts → local
#   edge = Microsoft Edge TTS (အခမဲ့၊ key မလို) ← ElevenLabs မရှိရင် ဒါကို သုံးတယ်
TTS_PROVIDER=auto

# Edge TTS (pip install edge-tts) — မြန်မာ voice: my-MM-NilarNeural (အမျိုးသမီး) / my-MM-ThihaNeural (အမျိုးသား)
EDGE_TTS_VOICE=
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%

# မြန်မာ TTS CLI (f5-myanmar-tts စသဖြင့်) — {text_file} နဲ့ {output} ကို အစားထိုးပေးတယ်
TTS_COMMAND=
# ဥပမာ: TTS_COMMAND="f5-tts_infer --gen_text_file {text_file} --output {output}"

# ElevenLabs deep voice (Charon) — အင်္ဂလိပ်/deep narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=Charon
# သိပြီးသား voice id ရှိရင် တိုက်ရိုက် ထည့်နိုင်တယ် (နာမည်နဲ့ ရှာစရာ မလို)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_CHUNK_CHARS=2500
TTS_CONCURRENCY=2

# ---------------------------------------------------------------- ပုံ / ဗီဒီယို
SCENES_PER_CHAPTER=2
IMAGE_CONCURRENCY=3
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

# ---------------------------------------------------------------- YouTube
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_LANGUAGE=my
YOUTUBE_MADE_FOR_KIDS=false
# သင့် channel handle (စစ်ဆေးရန်) — ဥပမာ airecapp  (လိုအပ်မှသာ)
YOUTUBE_CHANNEL_HANDLE=
# bot ထဲမှာ browser ဖွင့်လို့မရတာမို့ false ထားပြီး `python main.py auth` ကို တစ်ခါ run ပါ
YOUTUBE_INTERACTIVE=false
# `python main.py auth` မှာ localhost port (browser ဖွင့်တဲ့အခါ)
YOUTUBE_OAUTH_PORT=8085
# YOUTUBE_CLIENT_SECRETS=client_secret.json
# YOUTUBE_TOKEN_FILE=youtube-oauth2.json

# ---------------------------------------------------------------- မြန်မာ font (thumbnail)
# THUMBNAIL_FONT=assets/fonts/Padauk-Bold.ttf

# ---------------------------------------------------------------- runtime
DRY_RUN=false
FORCE_MOCK=false
# TEMP_DIR=temp
